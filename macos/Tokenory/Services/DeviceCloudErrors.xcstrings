{
  "sourceLanguage": "en",
  "strings": {
    "accountChanged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iCloud account changed. Enable sync for the current account to continue."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 账号已切换。请为当前账号重新开启同步。"
          }
        }
      }
    },
    "conflict": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud data changed during this operation. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作期间云端数据有更新，请重试。"
          }
        }
      }
    },
    "invalidData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud snapshot could not be verified."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证云端用量汇总。"
          }
        }
      }
    },
    "noAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to use device sync."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请登录 iCloud 以使用设备同步。"
          }
        }
      }
    },
    "revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync authorization was removed. Enable sync again to publish this Mac’s history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步授权已撤销。重新开启后可发布这台 Mac 的历史用量。"
          }
        }
      }
    },
    "staleRevision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer snapshot was requested for this Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已开始读取更新的用量汇总。"
          }
        }
      }
    },
    "stopped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device sync is turned off."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备同步已关闭。"
          }
        }
      }
    },
    "unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not have access to Tokenory’s iCloud container."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前版本没有 Tokenory 的 iCloud 同步权限。"
          }
        }
      }
    },
    "unconfirmedDeletion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deletion request was sent. Retry when online to confirm the result."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已发出删除请求。联网后请重试，以确认删除结果。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
