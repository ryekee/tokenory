      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Left and Right to inspect an hour or turn. Press Return to select it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按左右方向键查看时段或回合，按回车选中。"
          }
        }
      }
    },
