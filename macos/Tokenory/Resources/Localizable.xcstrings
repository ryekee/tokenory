    "turns.average_speed_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total generated tokens divided by total turn time, including tools and waiting. Generated tokens include reasoning, but exclude input and cache. ≈ means this range includes durations estimated from logs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总生成 tokens ÷ 总回合耗时，包含工具和等待。生成量含推理，不含输入与缓存。≈ 表示范围内包含按日志时间估算的回合。"
          }
        }
      }
    },
    "turns.average_ttft_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mean first-token wait for %lld of %lld turns with a recorded value. Missing values are excluded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对 %lld / %lld 个有记录的回合取首 token 等待时间的算术平均；缺失值不按零计算。"
          }
        }
      }
    },
