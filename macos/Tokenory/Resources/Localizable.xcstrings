        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peak: Monday to Friday, 09:00 to 12:00 and 14:00 to 18:00 Beijing time, excluding Chinese public holidays. Other hours, weekends and holidays cost 50% less. Cache hits, cache misses and output are priced separately."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高峰时段为北京时间周一至周五 09:00 至 12:00、14:00 至 18:00，中国法定节假日除外。其他时段、周末和节假日按半价计算。缓存命中、未命中和输出分别计费。"
          }
        }
