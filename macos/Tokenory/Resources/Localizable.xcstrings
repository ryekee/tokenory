        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimates use USD API rates. For codex-auto-review, Tokenory uses a tokens.ci reference estimate. Neither represents your bill. Missing prices fill automatically. Recalculate to update existing amounts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用按美元 API 费率估算；codex-auto-review 使用 tokens.ci 参考估算。估算不代表实际账单。待计价记录自动补齐；更新已有金额请使用「重新计算已有估算」。"
          }
        }
      }
