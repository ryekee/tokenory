    "turns.wait_help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool wait runs from the completed call to its returned result. Parallel waits count once. It includes execution, approval and scheduling, but excludes argument generation and background work after the tool returns. Other time still includes network, queueing and input processing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具等待从完整调用提交算到对应结果返回，并行等待只计一次。包含执行、审批与调度，不包含参数生成或工具返回后的后台运行。其余时间仍包含网络、排队和输入处理。"
          }
        }
      }
    },
    "turns.ttft_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First-token waiting time recorded by the client, when available. It is not necessarily the wait for the first visible character."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首 token 等待使用客户端明确记录的值；没有记录时显示 —。它不一定等于首个可见字符的等待时间。"
          }
        }
      }
    },
