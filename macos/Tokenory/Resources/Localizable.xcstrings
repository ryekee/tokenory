    "turns.unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn analysis is not yet available for these agents. Usage and cost tracking are unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下 agent 暂不支持回合分析，用量与费用统计不受影响。"
          }
        }
      }
    },
    "turns.estimated_help": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duration is estimated from the user-input timestamp to the completed final-response timestamp. Log writes and client scheduling can affect this interval; speed inherits that estimate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗时按用户输入至最终回复完成的日志时间差估算。日志落盘和客户端调度会影响该区间；速度也属于估算。"
          }
        }
      }
    },
    "menubar.cost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cost"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "费用"
          }
        }
      }
    },
    "menubar.speed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "速度"
          }
        }
      }
    },
    "turns.coverage.reason.missing_boundaries": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available log schema does not establish user-turn start and completion boundaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有日志结构无法确认用户回合的开始和完成边界。"
          }
        }
      }
    },
    "turns.coverage.reason.missing_timing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available records lack a start time, end time or duration for each turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有记录缺少每个回合的开始时间、结束时间或耗时。"
          }
        }
      }
    },
    "turns.coverage.reason.missing_usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available records lack attributable generated-token counts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有记录缺少可归属到回合的生成 token 数。"
          }
        }
      }
    },
    "turns.coverage.reason.missing_attribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage cannot be reliably linked to a main user turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用量无法可靠关联到用户主回合。"
          }
        }
      }
    },
    "turns.coverage.reason.request_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log records individual requests without a reliable user-turn boundary."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志记录了单次请求，但没有可靠的用户回合边界。"
          }
        }
      }
    },
    "turns.coverage.reason.session_totals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source provides session totals, not per-turn usage and timing."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来源提供会话汇总，未提供回合级用量和时间。"
          }
        }
      }
    },
    "turns.coverage.reason.schema_unverified": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The available schema evidence is insufficient to verify completed-turn metrics."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有结构证据不足，无法确认完成回合的统计口径。"
          }
        }
      }
    },
    "turns.coverage.reason.delegated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These entries use their underlying agents’ logs. Filtering includes all matching underlying-agent turns because the launcher is not recorded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些入口复用底层 agent 的日志。日志未记录启动入口，筛选会包含对应底层 agent 的全部回合。"
          }
        }
      }
    },
    "turns.coverage.remedy.record_boundaries": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture prompt submission and turn completion with a stable turn ID; link each request’s usage to that ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补采用户提交、回合完成及稳定回合 ID，并关联各请求用量。"
          }
        }
      }
    },
    "turns.coverage.remedy.record_timing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture monotonic start/end timestamps or elapsed duration alongside each turn’s usage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个回合补采单调时钟的起止时间或耗时，并与用量关联。"
          }
        }
      }
    },
    "turns.coverage.remedy.record_usage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capture final request usage, including output/reasoning semantics, and link it to a turn ID."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补采请求最终用量及输出/推理口径，并关联回合 ID。"
          }
        }
      }
    },
    "turns.coverage.remedy.record_attribution": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record main-turn, request and parent-agent IDs so child work can be separated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补采主回合、请求和父 agent ID，以分离子 agent 工作。"
          }
        }
      }
    },
    "turns.coverage.remedy.link_turn_requests": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add turn-start/finish events and request-to-turn IDs; request timing alone is insufficient."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补采回合起止事件及请求与回合的关联 ID；仅有请求耗时还不够。"
          }
        }
      }
    },
    "turns.coverage.remedy.export_turn_events": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export per-turn start, finish and final token usage; session totals cannot reconstruct historical turn speed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出逐回合起止事件和最终 token 用量；会话汇总无法还原历史回合速度。"
          }
        }
      }
    },
    "turns.coverage.remedy.verify_schema": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtain a documented schema or a complete redacted transcript containing timing, usage and completion events before enabling analysis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取得明确的结构文档或包含时间、用量、完成事件的完整脱敏日志，再启用分析。"
          }
        }
      }
    },
    "turns.coverage.remedy.filter_delegates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the underlying-agent filter; recording launcher identity would allow this entry to be separated."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可按底层 agent 筛选；若需区分该入口，应补采启动来源身份。"
          }
        }
      }
    },
    "turns.coverage.supported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
