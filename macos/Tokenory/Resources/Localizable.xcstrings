{
  "sourceLanguage": "en",
  "strings": {
    "cloud.pausing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finishing the current upload before pausing…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在完成本次上传，随后暂停同步…"
          }
        }
      }
    },
    "cloud.checkDeviceDeletion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check previous deletion for this Mac"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核实上次本机删除"
          }
        }
      }
    },
    "cloud.checkAllDeletion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check previous deletion for all Macs"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核实上次全部删除"
          }
        }
      }
    },
    "cloud.incompatibleDevices": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some Macs are missing from these totals. Update Tokenory on those Macs and sync again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分 Mac 的用量未计入。请在这些 Mac 上更新 Tokenory 后重新同步。"
          }
        }
      }
    },
    "settings.cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Sync"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步"
          }
        }
      }
    },
    "cloud.scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync this Mac’s usage and estimated costs through your private iCloud storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 iCloud 私有库同步本机的用量与估算费用汇总。"
          }
        }
      }
    },
    "cloud.just_now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "just now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刚刚"
          }
        }
      }
    },
    "cloud.last": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last synced %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近同步 %@"
          }
        }
      }
    },
    "cloud.refresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步"
          }
        }
      }
    },
    "cloud.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云端数据"
          }
        }
      }
    },
    "cloud.pauseNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning sync off keeps the last upload. Deleting cloud data keeps local ledgers."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭同步会保留上次上传的汇总。删除只影响云端。"
          }
        }
      }
    },
    "cloud.delete_data": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除数据"
          }
        }
      }
    },
    "cloud.choose_delete_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which cloud data to delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要删除的云端数据"
          }
        }
      }
    },
    "cloud.deleteDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete This Mac’s Cloud Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除本机云端数据"
          }
        }
      }
    },
    "cloud.deleteAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete All Cloud Data"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除全部云端数据"
          }
        }
      }
    },
    "cloud.confirmDevice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove this Mac’s contribution from every device and stop its uploads? Turning sync on again publishes its full history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从所有设备的合计中移除这台 Mac 的用量，并停止本机上传？手动重新开启后，会上传本机全部历史。"
          }
        }
      }
    },
    "cloud.confirmAll": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove every Mac’s cloud totals and stop all uploads? Each Mac must turn sync on again to republish its full history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除所有 Mac 的云端汇总并停止上传？每台 Mac 都需要手动重新开启，才会再次上传各自的全部历史。"
          }
        }
      }
    },
